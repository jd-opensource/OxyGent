# OxyGent Docker 环境变量配置
# 复制此文件为 .env: cp docker/env.example .env

# ============================================
# LLM 服务配置 (必需)
# ============================================

# 方式一: 使用 OpenAI API (推荐)
DEFAULT_LLM_API_KEY=your_openai_api_key_here
DEFAULT_LLM_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL_NAME=gpt-3.5-turbo

# 方式二: 使用其他兼容 API
# DEFAULT_LLM_API_KEY=your_api_key
# DEFAULT_LLM_BASE_URL=https://your-llm-service.com/v1
# DEFAULT_LLM_MODEL_NAME=your-model-name

# 方式三: 使用本地 Ollama (无需 API 密钥)
# 启动命令: ./docker-start.sh --ollama
# DEFAULT_LLM_API_KEY=not_required
# DEFAULT_LLM_BASE_URL=http://ollama:11434
# DEFAULT_LLM_MODEL_NAME=llama2

# ============================================
# 快速开始
# ============================================

# 1. 复制此文件: cp docker/env.example .env
# 2. 填入您的 LLM API 密钥 (上方 DEFAULT_LLM_API_KEY)
# 3. 启动服务: ./docker-start.sh
# 4. 访问: http://localhost:8080/web/index.html

# 💡 提示: 
# - 如果没有 API 密钥，可使用本地 Ollama: ./docker-start.sh --ollama
# - 首次启动需要几分钟下载镜像
# - .env 文件包含敏感信息，不要提交到版本控制
