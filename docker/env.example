# OxyGent Docker 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ============================================
# LLM 服务配置 (必需)
# ============================================

# OpenAI API 配置
DEFAULT_LLM_API_KEY=your_openai_api_key_here
DEFAULT_LLM_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL_NAME=gpt-3.5-turbo

# 或者使用其他 OpenAI 兼容的 API
# DEFAULT_LLM_API_KEY=your_api_key
# DEFAULT_LLM_BASE_URL=https://your-llm-service.com/v1
# DEFAULT_LLM_MODEL_NAME=your-model-name

# 或者使用本地 Ollama (需要启动 --profile with-ollama)
# DEFAULT_LLM_API_KEY=not_required_for_ollama
# DEFAULT_LLM_BASE_URL=http://host.docker.internal:11434
# DEFAULT_LLM_MODEL_NAME=llama2

# ============================================
# 应用配置
# ============================================

# 应用环境 (通常不需要修改)
APP_ENV=docker

# ============================================
# 数据库配置 (可选 - 使用容器内服务)
# ============================================

# Redis 配置 (如果使用外部 Redis)
# REDIS_HOST=your_redis_host
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# Elasticsearch 配置 (如果使用外部 ES)
# ES_HOST_1=your_es_host_1:9200
# ES_HOST_2=your_es_host_2:9200
# ES_HOST_3=your_es_host_3:9200
# ES_USER=your_es_username
# ES_PASSWORD=your_es_password

# ============================================
# 其他可选配置
# ============================================

# 日志级别
# LOG_LEVEL=INFO

# 部署阶段
# DEPLOYMENT_STAGE=docker

# ============================================
# 使用说明
# ============================================

# 1. 复制此文件: cp env.example .env
# 2. 编辑 .env 文件，填入实际的 API 密钥和配置
# 3. 运行: ./docker-start.sh

# 注意: .env 文件包含敏感信息，不要提交到版本控制系统
